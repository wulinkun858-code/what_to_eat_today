/* 青瓷山水 · 屏幕设计色，并非文物测色。来源见 docs/ink-celadon-sources.md。 */
/* 组件样式隔离时也在自身主题根节点取得基础令牌，不只依赖 page 继承。 */
page,
.theme-paper,
.theme-ink {
  /* ---------- 字体 ---------- */
  --font-display: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC",
    "SimSun", serif;
  --font-body: "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  --font-num: "DIN Alternate", "Bahnschrift", "Arial Narrow", "PingFang SC", sans-serif;

  /* ---------- 字号（7 档 + 角标） ---------- */
  --fs-badge: 20rpx;   /* 仅计数徽标 / 印章小字 */
  --fs-caption: 22rpx; /* 时间戳、辅助说明 */
  --fs-meta: 24rpx;    /* 次级信息、标签 */
  --fs-body: 28rpx;    /* 正文 */
  --fs-title: 30rpx;   /* 卡片标题、列表主文 */
  --fs-h2: 36rpx;      /* 区块标题 */
  --fs-h1: 48rpx;      /* 页面主标题、菜名 */
  --fs-display: 76rpx; /* 刊头 */

  --lh-tight: 1.1;
  --lh-snug: 1.3;
  --lh-normal: 1.6;
  --lh-relaxed: 1.8;

  /* ---------- 间距（4pt 网格） ---------- */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 48rpx;
  --sp-6: 64rpx;

  /* ---------- 圆角（4 档） ---------- */
  --r-xs: 12rpx;
  --r-md: 24rpx;
  --r-lg: 36rpx;
  --r-pill: 999rpx;

  /* ---------- 动效（5 档时长 / 3 条曲线） ---------- */
  --d-micro: 150ms;  /* 按压、颜色微变 */
  --d-short: 200ms;  /* 按钮、标签切换 */
  --d-medium: 280ms; /* 位移、让位、展开 */
  --d-long: 460ms;   /* 区域变化、轮播、页面淡入 */
  --d-sweep: 560ms;  /* 主题扫过（唯一允许超过 500ms 的场景） */
  --d-loop: 900ms;   /* 循环动画：旋转、搬运中 */
  --d-breathe: 1600ms; /* 循环动画：骨架屏呼吸 */

  --e-standard: cubic-bezier(0.2, 0, 0, 1);
  --e-decelerate: cubic-bezier(0.05, 0.7, 0.1, 1);
  --e-spring: cubic-bezier(0.2, 1.12, 0.4, 1); /* 过冲约 6%，只给 88rpx 以内的小元素 */

  /* ---------- 层级 ---------- */
  --z-nav: 100;
  --z-dock: 100;
  --z-sheet: 90;
  --z-float: 80;
  --z-reveal: 9999;

  --fs-hero: 84rpx;
  --d-stagger: 55ms;
  --d-reveal: 680ms;
  --gutter: 40rpx;
  --bg: #F3F5EE;
  --bg-2: #E7EEE5;
  --surface: #FCFDF8;
  --surface-2: #DFEAE1;
  --ink: #203D35;
  --ink-2: #496158;
  --ink-3: #586E64;
  --line: rgba(40, 83, 70, 0.13);
  --line-strong: rgba(40, 83, 70, 0.3);
  --band-bg: #DCE9E0;
  --band-ink: #203D35;
  --band-ink-2: #486557;
  --band-ink-3: #586E64;
  --band-ink-4: rgba(40, 83, 70, 0.18);
  --band-line: rgba(40, 83, 70, 0.2);
  --band-fill: rgba(40, 83, 70, 0.06);
  --accent: #2E6558;
  --accent-ink: #FAFCF5;
  --accent-soft: rgba(46, 101, 88, 0.09);
  --jade: #356A5B;
  --jade-soft: rgba(53, 106, 91, 0.1);
  --gold: #82704B;
  --gold-soft: rgba(130, 112, 75, 0.12);
  --seal-bg: #2E6558;
  --seal-ink: #FAFCF5;
  --vermilion: #A45143;
  --vermilion-ink: #FFF9F0;
  --wash: #C8DCD0;
  --halo: rgba(110, 152, 134, 0.18);
  --ok: #326B52;
  --info: #3C6470;
  --warn: #846124;
  --danger: #A04439;
  --danger-soft: rgba(160, 68, 57, 0.1);
  --photo-veil: rgba(0, 0, 0, 0.64);
  --photo-ink: #FAFCF5;
  --shadow-sm: 0 4rpx 16rpx rgba(36, 74, 59, 0.04);
  --shadow-md: 0 16rpx 48rpx rgba(36, 74, 59, 0.08);
}

.theme-paper {
  --bg: #F3F5EE;
  --bg-2: #E7EEE5;
  --surface: #FCFDF8;
  --surface-2: #DFEAE1;
  --ink: #203D35;
  --ink-2: #496158;
  --ink-3: #586E64;
  --line: rgba(40, 83, 70, 0.13);
  --line-strong: rgba(40, 83, 70, 0.3);
  --band-bg: #DCE9E0;
  --band-ink: #203D35;
  --band-ink-2: #486557;
  --band-ink-3: #586E64;
  --band-ink-4: rgba(40, 83, 70, 0.18);
  --band-line: rgba(40, 83, 70, 0.2);
  --band-fill: rgba(40, 83, 70, 0.06);
  --accent: #2E6558;
  --accent-ink: #FAFCF5;
  --accent-soft: rgba(46, 101, 88, 0.09);
  --jade: #356A5B;
  --jade-soft: rgba(53, 106, 91, 0.1);
  --gold: #82704B;
  --gold-soft: rgba(130, 112, 75, 0.12);
  --seal-bg: #2E6558;
  --seal-ink: #FAFCF5;
  --vermilion: #A45143;
  --vermilion-ink: #FFF9F0;
  --wash: #C8DCD0;
  --halo: rgba(110, 152, 134, 0.18);
  --ok: #326B52;
  --info: #3C6470;
  --warn: #846124;
  --danger: #A04439;
  --danger-soft: rgba(160, 68, 57, 0.1);
  --photo-veil: rgba(0, 0, 0, 0.64);
  --photo-ink: #FAFCF5;
  --shadow-sm: 0 4rpx 16rpx rgba(36, 74, 59, 0.04);
  --shadow-md: 0 16rpx 48rpx rgba(36, 74, 59, 0.08);
}

.theme-ink {
  /* 墨黑：中性炭黑、暖灰与米白，色彩只留给真实状态及朱印。 */
  --bg: #181818;
  --bg-2: #1E1E1E;
  --surface: #242424;
  --surface-2: #303030;
  --ink: #F0EDE6;
  --ink-2: #C7C1B7;
  --ink-3: #AAA49B;
  --line: rgba(240, 237, 230, 0.12);
  --line-strong: rgba(240, 237, 230, 0.26);
  --band-bg: #282828;
  --band-ink: #F0EDE6;
  --band-ink-2: #C7C1B7;
  --band-ink-3: #AAA49B;
  --band-ink-4: rgba(240, 237, 230, 0.16);
  --band-line: rgba(240, 237, 230, 0.2);
  --band-fill: rgba(240, 237, 230, 0.06);
  --accent: #D8D1C4;
  --accent-ink: #211F1B;
  --accent-soft: rgba(216, 209, 196, 0.1);
  --jade: #B3C7B8;
  --jade-soft: rgba(179, 199, 184, 0.1);
  --gold: #D4C1A0;
  --gold-soft: rgba(212, 193, 160, 0.1);
  --seal-bg: #D8D1C4;
  --seal-ink: #211F1B;
  --vermilion: #C88F80;
  --vermilion-ink: #211917;
  --wash: #89847C;
  --halo: rgba(216, 209, 196, 0.09);
  --ok: #B3C7B8;
  --info: #B6C6D0;
  --warn: #E0C189;
  --danger: #E3AAA0;
  --danger-soft: rgba(227, 170, 160, 0.1);
  --photo-veil: rgba(0, 0, 0, 0.64);
  --photo-ink: #FAF8F2;
  --shadow-sm: 0 4rpx 16rpx rgba(0, 0, 0, 0.16);
  --shadow-md: 0 16rpx 48rpx rgba(0, 0, 0, 0.24);
}
