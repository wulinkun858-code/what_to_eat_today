<view class="dock theme-{{theme}} {{reduce ? 'dock--reduce' : ''}}"><view class="dock__tabs"><view class="dock__mark" style="transform:translate3d({{selected * 100}}%,0,0)"></view><view wx:for="{{list}}" wx:key="pagePath" class="dock__tab {{selected === index ? 'dock__tab--on' : ''}}" data-path="{{item.pagePath}}" data-index="{{index}}" bindtap="switchTab" aria-label="{{item.text}}"><view class="dock__glyph dock__glyph--{{index}}"></view><text class="dock__tab-text">{{item.text}}</text></view></view><view class="dock__cart {{cartCount ? 'dock__cart--on' : ''}}" hover-class="{{cartCount ? 'dock__cart--press' : ''}}" bindtap="goCart"><view class="dock__bag"><view class="dock__bag-handle"></view><text class="dock__cart-count num">{{cartCount}}</text></view><view class="dock__cart-label">{{cartCount ? '去落单' : '点菜单'}}</view><text class="dock__cart-arrow">↗</text></view></view>
