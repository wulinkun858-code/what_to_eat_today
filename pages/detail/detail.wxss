.recipe { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.recipe-title { margin: 26rpx var(--gutter) 0; }
.recipe-title__eyebrow { display: flex; align-items: center; justify-content: space-between; font-size: var(--fs-caption); color: var(--ink-3); letter-spacing: 3rpx; }
.recipe-title__eyebrow text:first-child { color: var(--accent); }
.recipe-title__row { display: flex; align-items: center; justify-content: space-between; gap: 28rpx; margin-top: 24rpx; }
.recipe-title__name { font-size: var(--fs-display); font-weight: 400; letter-spacing: 4rpx; line-height: 1.35; overflow-wrap: break-word; }
.recipe-title__chef { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; color: var(--ink-2); font-size: var(--fs-caption); margin-top: 28rpx; }
.recipe-title__dot { width: 8rpx; height: 8rpx; background: var(--accent); border-radius: 50%; }
.recipe-title__note { color: var(--ink-3); margin-left: auto; }
.recipe-photo { position: relative; margin: 36rpx var(--gutter) 0; overflow: hidden; border-radius: var(--r-xs) var(--r-lg) var(--r-xs) var(--r-xs); background: var(--surface-2); }
.recipe-photo__swiper { height: 510rpx; }
.recipe-photo__img { width: 100%; height: 100%; }
.recipe-photo__caption { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; background: var(--surface); border: 1rpx solid var(--line); border-top: none; font-size: var(--fs-caption); color: var(--ink-3); letter-spacing: 3rpx; }
.recipe-photo--empty { height: 340rpx; }
.recipe-photo--empty image { width: 100%; height: 100%; opacity: 0.55; }
.theme-ink .recipe-photo--empty image { opacity: 0.18; filter: grayscale(1); }
.recipe-photo__empty-copy { position: absolute; left: 28rpx; top: 40rpx; font-size: var(--fs-title); color: var(--ink); letter-spacing: 3rpx; }
.recipe-body { margin: 0 var(--gutter); }
.recipe-description { margin-top: 34rpx; font-size: var(--fs-body); line-height: 1.95; color: var(--ink-2); white-space: pre-wrap; }
.recipe-tags { display: flex; flex-wrap: wrap; gap: 12rpx 22rpx; margin-top: 22rpx; font-size: var(--fs-caption); color: var(--accent); }
.recipe-tags text::before { content: '#'; opacity: 0.6; margin-right: 5rpx; }
.recipe-section { margin-top: 56rpx; }
.recipe-section__head { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; padding-bottom: 22rpx; border-bottom: 1rpx solid var(--line-strong); }
.recipe-section__label { display: flex; align-items: baseline; gap: 18rpx; font-size: var(--fs-h2); letter-spacing: 2rpx; }
.recipe-section__number { font-size: var(--fs-caption); color: var(--accent); }
.recipe-section__meta { color: var(--ink-3); font-size: var(--fs-badge); letter-spacing: 2rpx; }
.ingredients { display: flex; flex-wrap: wrap; padding: 14rpx 0; }
.ingredient { width: 50%; display: flex; align-items: baseline; padding: 16rpx 18rpx 16rpx 0; border-bottom: 1rpx solid var(--line); font-size: var(--fs-body); color: var(--ink-2); line-height: 1.8; }
.ingredient__dot { width: 5rpx; height: 5rpx; margin-right: 18rpx; flex-shrink: 0; border-radius: 50%; background: var(--accent); }
.steps { margin-top: 28rpx; }
.step { display: flex; align-items: flex-start; gap: 24rpx; padding-bottom: 32rpx; position: relative; }
.step::before { content: ''; position: absolute; left: 28rpx; top: 52rpx; bottom: 0; width: 1rpx; background: var(--line); }
.step:last-child::before { display: none; }
.step__number { width: 56rpx; height: 56rpx; border-radius: 50%; border: 1rpx solid var(--line-strong); flex-shrink: 0; display: flex; justify-content: center; align-items: center; font-size: var(--fs-meta); color: var(--accent); }
.step__text { flex: 1; min-width: 0; font-size: var(--fs-body); color: var(--ink-2); line-height: 1.9; padding-top: 5rpx; overflow-wrap: break-word; white-space: pre-wrap; }
.composer { margin-top: 26rpx; display: flex; align-items: center; background: var(--surface); border: 1rpx solid var(--line); padding: 6rpx 12rpx 6rpx 22rpx; border-radius: var(--r-xs); }
.composer__input { min-width: 0; flex: 1; height: 88rpx; font-size: var(--fs-meta); color: var(--ink); }
.composer__ph { color: var(--ink-3); }
.composer__send { min-width: 96rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; color: var(--ink-3); font-size: var(--fs-meta); }
.composer__send--on { color: var(--accent); }
.cmt { display: flex; align-items: flex-start; gap: 18rpx; padding: 26rpx 0; border-bottom: 1rpx solid var(--line); transition: transform var(--d-medium) var(--e-standard), opacity var(--d-medium) var(--e-standard); }
.cmt__mark { color: var(--wash); font-size: var(--fs-h1); line-height: 1.3; }
.cmt__body { flex: 1; min-width: 0; }
.cmt__text { font-size: var(--fs-body); color: var(--ink-2); line-height: 1.8; white-space: pre-wrap; overflow-wrap: break-word; }
.cmt__time { font-size: var(--fs-caption); color: var(--ink-3); margin-top: 12rpx; }
.cmt--out { transform: translate3d(40rpx, 0, 0); opacity: 0; }
.cmt__empty { font-size: var(--fs-meta); color: var(--ink-3); padding: 36rpx 0; text-align: center; }
.recipe-colophon { display: flex; align-items: center; justify-content: center; gap: 22rpx; margin-top: 50rpx; font-size: var(--fs-caption); color: var(--ink-3); letter-spacing: 3rpx; }
.recipe-delete { min-height: 88rpx; display: flex; justify-content: center; align-items: center; margin-top: 12rpx; color: var(--danger); font-size: var(--fs-caption); }
.recipe-actions { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx var(--gutter) calc(20rpx + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1rpx solid var(--line); display: flex; align-items: center; gap: 32rpx; z-index: var(--z-dock); }
.recipe-actions__edit { min-width: 180rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: var(--fs-meta); color: var(--accent); border: 1rpx solid var(--line-strong); border-radius: var(--r-pill); }
.recipe-actions__note { color: var(--ink-3); font-size: var(--fs-caption); letter-spacing: 3rpx; line-height: 1.7; white-space: pre-line; }
.recipe-actions__add { min-width: 0; flex: 1; height: 92rpx; padding: 0 34rpx; background: var(--accent); color: var(--accent-ink); border-radius: var(--r-pill); display: flex; align-items: center; justify-content: space-between; font-size: var(--fs-body); letter-spacing: 2rpx; }
.recipe-sk { width: 70%; height: 50rpx; margin-top: 20rpx; }
.reduce-motion .cmt { transition: none; }
