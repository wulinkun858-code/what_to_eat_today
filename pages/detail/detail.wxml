<!-- 一味食帖：题签、独幅菜影、食材清单与做法长卷 -->
<view class="page {{pageVisible ? '' : 'motion-paused'}} {{motionSettled ? 'motion-settled' : ''}} recipe theme-{{theme}} {{reduce ? 'reduce-motion' : ''}}" wx:if="{{dish}}">
  <nav-bar title="一味 · 食帖" />
  <view class="recipe-title ink-rise"><view class="recipe-title__eyebrow"><text>{{dish.categoryName || '日常食事'}}</text><text class="num">RECIPE / 一味</text></view><view class="recipe-title__row"><view class="recipe-title__name serif">{{dish.name}}</view><view class="seal seal--sm">馔</view></view><view class="recipe-title__chef"><view class="recipe-title__dot"></view><text>{{dish.chefNickname || '厨师'}} 掌勺</text><text class="recipe-title__note">一箸一味，皆是用心</text></view></view>
  <view class="recipe-photo ink-rise delay-1" wx:if="{{dishImages.length}}"><swiper class="recipe-photo__swiper" circular autoplay="{{pageVisible && heroAutoplay && !reduce}}" interval="{{6000}}" duration="{{reduce ? 0 : 460}}" bindchange="onHeroChange" bindtouchstart="onHeroTouchStart"><swiper-item wx:for="{{dishImages}}" wx:key="*this"><image class="recipe-photo__img" src="{{item}}" mode="aspectFill" bindtap="onHeroTap" /></swiper-item></swiper><view class="recipe-photo__caption"><text class="serif">食之本味</text><text class="num">{{heroCurrent + 1}} / {{dishImages.length}}</text></view></view>
  <view class="recipe-photo recipe-photo--empty" wx:else><image src="/assets/art/celadon-landscape.jpg" mode="aspectFill" /><view class="recipe-photo__empty-copy serif">未有菜影，先记滋味。</view></view>
  <view class="recipe-body">
    <view class="recipe-description ink-rise delay-2" wx:if="{{dish.description}}">{{dish.description}}</view>
    <view class="recipe-tags" wx:if="{{dish.tags.length}}"><text wx:for="{{dish.tags}}" wx:key="*this">{{item}}</text></view>
    <view class="recipe-section" wx:if="{{dish.ingredients.length}}"><view class="recipe-section__head"><view class="recipe-section__label"><text class="recipe-section__number num">01</text><text class="serif">备一味食材</text></view><text class="recipe-section__meta">INGREDIENTS</text></view><view class="ingredients"><view class="ingredient" wx:for="{{dish.ingredients}}" wx:key="*this"><view class="ingredient__dot"></view><text>{{item}}</text></view></view></view>
    <view class="recipe-section" wx:if="{{dish.steps.length}}"><view class="recipe-section__head"><view class="recipe-section__label"><text class="recipe-section__number num">02</text><text class="serif">慢慢做成欢喜</text></view><text class="recipe-section__meta">METHOD</text></view><view class="steps"><view class="step" wx:for="{{dish.steps}}" wx:key="*this"><view class="step__number num">{{index < 9 ? '0' : ''}}{{index + 1}}</view><view class="step__text">{{item}}</view></view></view></view>
    <view class="recipe-section"><view class="recipe-section__head"><view class="recipe-section__label"><text class="recipe-section__number num">03</text><text class="serif">食后有话</text></view><text class="recipe-section__meta">{{commentTotal}} 则心得</text></view><view class="composer"><input class="composer__input" placeholder="记下这一味的心得" placeholder-class="composer__ph" confirm-type="send" maxlength="{{commentMaxLength}}" value="{{commentDraft}}" bindinput="onCmtInput" bindconfirm="onCmtSend" /><view class="composer__send {{commentDraft ? 'composer__send--on' : ''}}" bindtap="onCmtSend" hover-class="is-pressed">{{commentSending ? '落笔中' : '落笔'}}</view></view><view class="cmt {{removingCmtIndex === index ? 'cmt--out' : ''}}" wx:for="{{commentList}}" wx:key="_id" data-index="{{index}}" bindlongpress="onCmtRemove"><text class="cmt__mark serif">“</text><view class="cmt__body"><view class="cmt__text">{{item.content}}</view><view class="cmt__time">{{item.timeText}}</view></view></view><view class="cmt__empty" wx:if="{{!commentList.length}}">一笺空白，等你写下第一笔。</view></view>
    <view class="recipe-colophon"><text class="serif">一餐有尽，余味悠长。</text><view class="seal seal--sm">食</view></view>
    <view class="recipe-delete" wx:if="{{canManage}}" bindtap="onDeleteTap">删除这道菜</view>
  </view>
  <view class="recipe-actions"><view wx:if="{{canManage}}" class="recipe-actions__edit" bindtap="onEditTap" hover-class="is-pressed">编辑菜谱</view><view wx:else class="recipe-actions__note serif">心有所念
一味入单</view><view class="recipe-actions__add" bindtap="onAddToCart" hover-class="is-pressed"><text>{{inCart ? '查看点菜单' : '加入点菜单'}}</text><text>{{inCart ? '↗' : '＋'}}</text></view></view>
</view>
<view class="page {{pageVisible ? '' : 'motion-paused'}} {{motionSettled ? 'motion-settled' : ''}} recipe theme-{{theme}} {{reduce ? 'reduce-motion' : ''}}" wx:elif="{{loading}}"><nav-bar title="一味 · 食帖" /><view class="recipe-title"><view class="skeleton recipe-sk"></view><view class="skeleton recipe-sk"></view></view><view class="recipe-photo skeleton"></view></view>
<view class="page {{pageVisible ? '' : 'motion-paused'}} {{motionSettled ? 'motion-settled' : ''}} recipe theme-{{theme}} {{reduce ? 'reduce-motion' : ''}}" wx:else><nav-bar title="一味 · 食帖" /><view class="empty"><view class="empty__halo"></view><text class="empty__title">这一味暂未寻得</text><text class="empty__sub">返回食帖，看看其他家常滋味。</text></view></view>
