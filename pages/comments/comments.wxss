.journal { padding-bottom: calc(184rpx + env(safe-area-inset-bottom)); }
.journal-top { padding: 0 var(--gutter); height: 104rpx; display: flex; align-items: center; gap: 24rpx; }
.journal-top text:first-child { font-size: var(--fs-body); letter-spacing: 4rpx; }
.journal-top text:last-child { font-size: var(--fs-badge); color: var(--ink-3); }
.journal-heading { margin: 36rpx var(--gutter) 0; }
.journal-heading__title { display: flex; align-items: center; gap: 28rpx; margin-top: 18rpx; font-size: var(--fs-display); letter-spacing: 6rpx; font-weight: 400; }
.journal-heading__description { font-size: var(--fs-meta); color: var(--ink-2); margin-top: 18rpx; letter-spacing: 2rpx; }
.journal-heading__foot { margin-top: 38rpx; padding: 20rpx 0; border-top: 1rpx solid var(--line-strong); display: flex; justify-content: space-between; color: var(--ink-3); font-size: var(--fs-caption); letter-spacing: 2rpx; }
.journal-feed { margin: 12rpx var(--gutter) 0; }
.journal-entry { position: relative; display: flex; gap: 24rpx; padding-bottom: 28rpx; }
.journal-entry::before { content: ''; position: absolute; width: 1rpx; background: var(--line); top: 38rpx; bottom: -18rpx; left: 28rpx; }
.journal-entry:last-child::before { display: none; }
.journal-entry__date { width: 56rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; padding-top: 16rpx; position: relative; }
.journal-entry__number { font-size: var(--fs-meta); color: var(--accent); background: var(--bg); padding: 0 8rpx; }
.journal-entry__dot { width: 7rpx; height: 7rpx; margin-top: 10rpx; border-radius: 50%; background: var(--accent); }
.journal-note { position: relative; flex: 1; min-width: 0; background: var(--surface); padding: 28rpx 30rpx; border: 1rpx solid var(--line); border-radius: var(--r-lg); overflow: hidden; transition: opacity var(--d-micro) var(--e-standard); }
.journal-note--press { opacity: 0.7; }
.journal-note__quote { font-size: var(--fs-display); color: var(--wash); line-height: 0.9; height: 44rpx; }
.journal-note__text { font-size: var(--fs-body); color: var(--ink); line-height: 1.95; white-space: pre-wrap; overflow-wrap: break-word; }
.journal-note__foot { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding-top: 18rpx; border-top: 1rpx solid var(--line); gap: 16rpx; }
.journal-note__dish { font-family: var(--font-display); color: var(--accent); font-size: var(--fs-meta); letter-spacing: 2rpx; }
.journal-note__arrow { color: var(--accent); font-size: var(--fs-meta); }
.journal-note__time { display: block; margin-top: 10rpx; color: var(--ink-3); font-size: var(--fs-caption); }
.journal-end { padding: 28rpx var(--gutter); text-align: center; color: var(--ink-3); font-family: var(--font-display); font-size: var(--fs-caption); letter-spacing: 4rpx; }
.journal-sk { width: 90%; height: 24rpx; margin-bottom: 20rpx; }
