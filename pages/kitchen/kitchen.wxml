<view class="page {{pageVisible ? '' : 'motion-paused'}} {{motionSettled ? 'motion-settled' : ''}} kitchen-page theme-{{theme}} {{reduce ? 'reduce-motion' : ''}} page-enter">
  <nav-bar title="" />
  <view class="kitchen-head"><view class="eyebrow">掌勺人的一方天地</view><view class="kitchen-head__row"><view class="kitchen-title">灶间清事</view><view class="kitchen-mark">炊</view></view><view class="kitchen-intro">择一味，起一灶，把一餐的期待变成烟火。</view><view class="kitchen-stats"><view class="stat"><text class="stat__num num">{{unreadCount}}</text><text>未读飞帖</text></view><view class="stat__line"></view><view class="stat"><text class="stat__num num">{{cooklist.length}}</text><text>制作清单</text></view></view></view>
  <view class="work-section"><view class="work-title"><view><text class="work-title__index">01</text><text>报餐飞帖</text></view><text class="work-title__sub">点击可阅</text></view>
    <view class="board-ticket {{item.read ? 'board-ticket--read' : ''}}" wx:for="{{messages}}" wx:key="_id" data-id="{{item._id}}" bindtap="onMessageTap"><view class="ticket__top"><view class="ticket__identity"><view class="ticket__dot" wx:if="{{!item.read}}"></view><text class="ticket__diner">{{item.dinerNickname}} 的报餐</text></view><text class="ticket__time">{{item.timeText}}</text></view><view class="ticket__dishes">{{item.items}}</view><view class="ticket__foot"><text class="ticket__status" wx:if="{{item.statusText}}">订单{{item.statusText}}</text><view class="ticket__action" wx:if="{{item.actionable}}" hover-class="control--press" hover-stay-time="60" data-order-id="{{item.orderId}}" data-index="{{index}}" catchtap="onAddAllTap">加入制作 <text>↗</text></view></view></view>
    <view class="board-ticket board-ticket--sk" wx:if="{{loading && !messages.length}}" wx:for="{{[1,2]}}" wx:key="*this"><view class="skeleton sk-line"></view><view class="skeleton sk-line sk-line--long"></view></view>
    <view class="board-empty" wx:if="{{!loading && !messages.length}}"><text class="board-empty__mark">信</text><text>飞帖未至，且候一餐。</text></view>
  </view>
  <view class="work-section"><view class="work-title"><view><text class="work-title__index">02</text><text>灶上食单</text></view><text class="work-title__sub">全部起菜后自动完结</text></view>
    <view class="cook-list"><view class="cook-row {{item.done ? 'cook-row--done' : ''}}" wx:for="{{cooklist}}" wx:key="_id"><view class="cook-check {{item.done ? 'cook-check--on' : ''}}" data-id="{{item._id}}" catchtap="onDoneTap" aria-label="{{item.done ? '已完成' : '标记完成'}}"><view class="cook-check__glyph"><text wx:if="{{item.done}}">✓</text><text wx:else class="cook-check__empty"></text></view></view><view class="cook-body"><view class="cook-name {{item.done ? 'cook-name--done' : ''}}">{{item.dishName}}</view><view class="cook-meta" wx:if="{{item.dinerNickname}}">{{item.dinerNickname}} 点的 · {{item.timeText}}</view><view class="cook-meta" wx:else>{{item.timeText}}</view></view><view class="cook-remove" data-id="{{item._id}}" catchtap="onRemoveTap">移除</view></view></view>
    <view class="board-empty" wx:if="{{!cooklist.length && !loading}}"><text class="board-empty__mark">灶</text><text>灶上还空着，从飞帖里挑一单起菜。</text></view>
  </view>
  <view class="loading" wx:if="{{loading}}">正在整理灶间…</view>
</view>
