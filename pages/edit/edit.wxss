.page { min-height: 100vh; padding-bottom: 0; background: var(--bg); }
.editor-head { margin: var(--sp-4) var(--sp-4) var(--sp-5); padding-bottom: var(--sp-4); border-bottom: 1rpx solid var(--line-strong); }
.eyebrow { font-size: var(--fs-caption); color: var(--accent); letter-spacing: 4rpx; }
.editor-head__row { display: flex; align-items: center; justify-content: space-between; margin: var(--sp-3) 0; }
.editor-title { font-family: var(--font-display); font-size: var(--fs-h1); color: var(--ink); letter-spacing: 3rpx; line-height: var(--lh-snug); }
.editor-mark { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; flex-shrink: 0; margin-left: var(--sp-2); border: 1rpx solid var(--accent); border-radius: var(--r-xs); color: var(--accent); font-family: var(--font-display); font-size: var(--fs-title); transform: rotate(-5deg); }
.editor-intro { font-size: var(--fs-meta); color: var(--ink-3); line-height: var(--lh-relaxed); }
.editor-status { margin: var(--sp-3) var(--sp-4); color: var(--ink-3); font-size: var(--fs-meta); }
.form { margin: 0 var(--sp-4); }
.form-section { padding: var(--sp-4); margin-bottom: var(--sp-4); border: 1rpx solid var(--line); border-radius: var(--r-lg); background: var(--surface); }
.form-section--cover { background: var(--accent-soft); }
.section-label { display: flex; align-items: center; margin-bottom: var(--sp-3); font-family: var(--font-display); font-size: var(--fs-title); color: var(--ink); }
.section-label__no { color: var(--accent); margin-right: var(--sp-2); }
.form-sub { margin-left: auto; font-family: var(--font-body); font-size: var(--fs-caption); color: var(--ink-3); }
.form-item { margin-top: var(--sp-4); }
.form-label { display: flex; align-items: center; font-size: var(--fs-meta); color: var(--ink-2); }
.required { margin-left: var(--sp-1); color: var(--danger); }
.form-input { height: 88rpx; width: 100%; border-bottom: 1rpx solid var(--line); color: var(--ink); font-size: var(--fs-body); }
.form-input--title { height: 104rpx; font-family: var(--font-display); font-size: var(--fs-h2); }
.form-ph, .category-value--empty { color: var(--ink-3); }
.form-error { margin-top: var(--sp-1); color: var(--danger); font-size: var(--fs-caption); }
.form-textarea { box-sizing: border-box; width: 100%; min-height: 180rpx; margin-top: var(--sp-2); padding: var(--sp-2); background: var(--bg); border-radius: var(--r-xs); font-size: var(--fs-body); line-height: var(--lh-relaxed); color: var(--ink); }
.form-textarea--short { min-height: 100rpx; }
.form-textarea--steps { min-height: 240rpx; }
.category-picker { display: flex; align-items: center; min-height: 88rpx; border-bottom: 1rpx solid var(--line); }
.category-value { flex: 1; min-width: 0; font-size: var(--fs-body); color: var(--ink); }
.category-value--empty { color: var(--ink-3); }
.chev { width: 12rpx; height: 12rpx; border-top: 2rpx solid var(--accent); border-right: 2rpx solid var(--accent); transform: rotate(45deg); }
.image-grid { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
.image-cell, .image-add { position: relative; box-sizing: border-box; width: calc(33.333% - 11rpx); height: 176rpx; overflow: hidden; border-radius: var(--r-md); }
.image-thumb { display: block; width: 100%; height: 100%; background: var(--surface-2); }
.image-remove { position: absolute; top: 0; right: 0; display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; color: var(--ink); font-size: var(--fs-title); }
.image-remove__glyph { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--surface); }
.image-cover { position: absolute; bottom: var(--sp-1); left: var(--sp-1); padding: 4rpx var(--sp-1); border-radius: var(--r-xs); color: var(--accent-ink); background: var(--accent); font-size: var(--fs-caption); }
.image-add { display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--accent); border: 1rpx dashed var(--line-strong); background: var(--surface); font-size: var(--fs-caption); transition: transform var(--d-short) var(--e-standard); }
.image-add__plus { font-size: var(--fs-h2); margin-bottom: var(--sp-1); }
.image-uploading { margin-top: var(--sp-2); color: var(--accent); font-size: var(--fs-caption); }
.submit-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: var(--z-dock); display: flex; align-items: center; justify-content: space-between; padding: var(--sp-3) var(--sp-4) calc(var(--sp-3) + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: var(--surface); }
.submit-bar__copy { display: flex; flex-direction: column; }
.submit-bar__title { color: var(--ink); font-size: var(--fs-body); font-family: var(--font-display); letter-spacing: 2rpx; }
.submit-bar__sub { margin-top: 4rpx; color: var(--ink-3); font-size: var(--fs-caption); }
.submit-btn { padding: var(--sp-3) var(--sp-4); border-radius: var(--r-pill); background: var(--accent); color: var(--accent-ink); font-size: var(--fs-body); transition: transform var(--d-short) var(--e-standard), opacity var(--d-short) var(--e-standard); }
.submit-btn--disabled { opacity: .45; }
.control--press { transform: scale(.97); opacity: .8; }
.bottom-placeholder { height: calc(164rpx + env(safe-area-inset-bottom)); }
.reduce-motion .image-add, .reduce-motion .submit-btn { transition: none; }


.editor-status--error { padding: var(--sp-3); border: 1rpx solid var(--danger); border-radius: var(--r-md); color: var(--danger); background: var(--danger-soft); }
.editor-status__hint { margin-top: var(--sp-1); font-size: var(--fs-caption); line-height: var(--lh-normal); }

.reduce-motion .control--press { transform: none; }
